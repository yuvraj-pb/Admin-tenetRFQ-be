# ── Runtime ──────────────────────────────────────────────
NODE_ENV=development
PORT=4005

# ── Database (SAME as main backend advanceRfq-be) ────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=advance_rfq
DB_USER=postgres
DB_PASSWORD=
DB_LOGGING=false

# ── Auth (MUST be identical to main backend's JWT_SECRET) ─
JWT_SECRET=

# ── CORS (the Next.js frontend origins, comma-separated) ─
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Super Admin seed (npm run seed) ──────────────────────
SUPER_ADMIN_EMAIL=superadmin@potatobazaar.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# ── Billing: Razorpay ────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Billing: Stripe ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:3000/super-admin/subscriptions?status=success
STRIPE_CANCEL_URL=http://localhost:3000/super-admin/subscriptions?status=cancelled

# ── Email (optional v1 — for temp passwords / invites) ───
MAIL_PROVIDER=none
SES_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
SENDER_EMAIL=no-reply@potatobazaar.com
SENDGRID_API_KEY=

# ── Frontend (used in credential emails) ─────────────────
FRONTEND_URL=http://localhost:3000/login

# ── Platform defaults ────────────────────────────────────
DEFAULT_CURRENCY=INR
EXPIRING_WITHIN_DAYS=30
